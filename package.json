{
  "name": "reutrack",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./src/bin/www",
    "server": "nodemon ./src/bin/www",
    "start:prod": "cross-env NODE_ENV=production node ./src/bin/www",
    "start:dev": "cross-env NODE_ENV=development node ./src/bin/www",
    "migrate": "npx sequelize-cli db:migrate",
    "migration:generate": "npx sequelize-cli migration:generate --name",
    "seed": "npx sequelize-cli db:seed:all",
    "seed:undo": "npx sequelize-cli db:seed:undo:all",
    "seed:gen": "npx sequelize-cli seed:generate --name"
  },
  "dependencies": {
    "@sequelize/mariadb": "^7.0.0-alpha.46",
    "ajv": "^8.17.1",
    "ajv-errors": "^3.0.0",
    "axios": "^1.19.0",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.3",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "crypto": "^1.0.1",
    "debug": "~2.6.9",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "htmlparser2": "^10.0.0",
    "http-errors": "~1.6.3",
    "jade": "^0.29.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^3.0.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "mysql2": "^3.12.0",
    "node-html-parser": "^7.0.1",
    "nodemailer": "^9.0.5",
    "nodemon": "^3.1.9",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.16.0",
    "puppeteer": "^25.9.0",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.2",
    "sharp": "^0.35.3",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  },
  "overrides": {
    "tar": "^7.5.11",
    "serialize-javascript": "^7.0.3",
    "uuid": "^11.1.1"
  }
}
